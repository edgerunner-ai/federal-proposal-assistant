{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Differentiator Comparison Graphic — Data Schema",
  "description": "A 3-column comparison matrix (Proprietary vs Open-Weight vs EdgeRunner AI) with N dimension rows. Each cell has an icon state, label, and sublabel.",
  "type": "object",
  "required": ["title", "subtitle", "columns", "rows", "footer"],
  "properties": {
    "title": {"type": "string", "maxLength": 140},
    "subtitle": {"type": "string", "maxLength": 220},
    "columns": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "description": "Column headers, left to right. Last column gets hero (red) treatment.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "maxLength": 50},
          "sub": {"type": "string", "maxLength": 80}
        }
      }
    },
    "rows": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["dimension", "cells"],
        "properties": {
          "dimension": {"type": "string", "maxLength": 50},
          "dimension_sub": {"type": "string", "maxLength": 60},
          "cells": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["state", "label"],
              "properties": {
                "state": {"type": "string", "enum": ["no", "partial", "yes"]},
                "label": {"type": "string", "maxLength": 60},
                "sub": {"type": "string", "maxLength": 100}
              }
            }
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "required": ["brand", "tagline"],
      "properties": {
        "brand": {"type": "string", "maxLength": 40},
        "tagline": {"type": "string", "maxLength": 160},
        "website": {"type": "string", "maxLength": 60}
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "bg": {"type": "string", "default": "#191c20"},
        "accent": {"type": "string", "default": "#ee2929"},
        "amber": {"type": "string", "default": "#c8a200"},
        "panel": {"type": "string", "default": "#2a2d31"},
        "panel_border": {"type": "string", "default": "#393939"},
        "text": {"type": "string", "default": "#ffffff"},
        "muted": {"type": "string", "default": "#9f9f9f"},
        "body": {"type": "string", "default": "#c8c8c8"}
      }
    }
  }
}
