{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deployment Spectrum Graphic — Data Schema",
  "description": "A horizontal 4-column layout showing deployment environments from connected (left) to autonomous (right). Rightmost columns get hero (red) treatment. Each column has sections for deployment details, use cases, and connectivity.",
  "type": "object",
  "required": ["title", "subtitle", "spectrum", "columns", "tagline", "footer"],
  "properties": {
    "title": {"type": "string", "maxLength": 120},
    "subtitle": {"type": "string", "maxLength": 200},
    "spectrum": {
      "type": "object",
      "required": ["left_label", "right_label"],
      "properties": {
        "left_label": {"type": "string", "maxLength": 30},
        "right_label": {"type": "string", "maxLength": 30}
      }
    },
    "columns": {
      "type": "array", "minItems": 3, "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["name", "sub", "deployment", "use_cases", "connectivity", "connectivity_badge"],
        "properties": {
          "name": {"type": "string", "maxLength": 40},
          "sub": {"type": "string", "maxLength": 60},
          "hero": {"type": "boolean", "default": false, "description": "If true, gets red accent treatment"},
          "deployment": {"type": "array", "items": {"type": "string", "maxLength": 50}, "minItems": 1, "maxItems": 4},
          "use_cases": {"type": "array", "items": {"type": "string", "maxLength": 50}, "minItems": 1, "maxItems": 4},
          "connectivity": {"type": "string", "maxLength": 40},
          "connectivity_badge": {"type": "string", "maxLength": 40}
        }
      }
    },
    "tagline": {"type": "string", "maxLength": 160},
    "footer": {
      "type": "object",
      "required": ["brand", "tagline"],
      "properties": {
        "brand": {"type": "string", "maxLength": 40},
        "tagline": {"type": "string", "maxLength": 160},
        "website": {"type": "string", "maxLength": 60}
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "bg": {"type": "string", "default": "#191c20"},
        "accent": {"type": "string", "default": "#ee2929"},
        "panel": {"type": "string", "default": "#2a2d31"},
        "panel_border": {"type": "string", "default": "#393939"},
        "text": {"type": "string", "default": "#ffffff"},
        "muted": {"type": "string", "default": "#9f9f9f"},
        "body": {"type": "string", "default": "#c8c8c8"}
      }
    }
  }
}
