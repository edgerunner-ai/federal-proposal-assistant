{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Human-Machine Teaming Workflow — Data Schema",
  "description": "A left-to-right 5-step workflow showing operator → system interaction. Step 3 (center) gets hero treatment. Bottom has a feedback arc and 3 principle callout boxes.",
  "type": "object",
  "required": ["title", "subtitle", "steps", "feedback", "principles", "footer"],
  "properties": {
    "title": {"type": "string", "maxLength": 120},
    "subtitle": {"type": "string", "maxLength": 200},
    "steps": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "sub", "lines"],
        "properties": {
          "name": {"type": "string", "maxLength": 40},
          "sub": {"type": "string", "maxLength": 20, "description": "e.g. 'Step 1'"},
          "hero": {"type": "boolean", "default": false},
          "lines": {"type": "array", "items": {"type": "string", "maxLength": 40}, "minItems": 1, "maxItems": 5},
          "bottom_note": {"type": "string", "maxLength": 40},
          "top_icon": {"type": "string", "maxLength": 10, "description": "Optional icon/emoji above the box"},
          "top_label": {"type": "string", "maxLength": 20, "description": "Label below the icon"}
        }
      }
    },
    "feedback": {"type": "object", "required": ["label"], "properties": {"label": {"type": "string", "maxLength": 160}}},
    "principles": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["title", "sub"],
        "properties": {
          "title": {"type": "string", "maxLength": 40},
          "sub": {"type": "string", "maxLength": 60}
        }
      }
    },
    "footer": {
      "type": "object", "required": ["brand", "tagline"],
      "properties": {
        "brand": {"type": "string", "maxLength": 40},
        "tagline": {"type": "string", "maxLength": 160},
        "website": {"type": "string", "maxLength": 60}
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "bg": {"type": "string", "default": "#191c20"},
        "accent": {"type": "string", "default": "#ee2929"},
        "panel": {"type": "string", "default": "#2a2d31"},
        "panel_border": {"type": "string", "default": "#393939"},
        "text": {"type": "string", "default": "#ffffff"},
        "muted": {"type": "string", "default": "#9f9f9f"},
        "body": {"type": "string", "default": "#c8c8c8"}
      }
    }
  }
}
